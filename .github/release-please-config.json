{
  "$schema": "https://googleapis.github.io/release-please/schemas/config.json",
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore(release): 版本发布",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactors", "hidden": true },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build System", "hidden": true },
    { "type": "ci", "section": "CI/CD", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true }
  ],

  "packages": {
    "packages/vscode-utils": {
      "release-type": "node",
      "package": "@eastgold15/vscode-utils",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/vscode-webview": {
      "release-type": "node",
      "package": "@eastgold15/vscode-webview",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/vite-plugin-vscode": {
      "release-type": "node",
      "package": "@eastgold15/vite-plugin-vscode",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/create-vscodep": {
      "release-type": "node",
      "package": "@eastgold15/vscodep-cli",
      "changelog-path": "CHANGELOG.md"
    }
  },
  "plugins": [{ "type": "node-workspace" }]
}
