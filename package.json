{
  "name": "vscode-plugin-monorepo",
  "description": "VSCode 扩展开发工具链：脚手架 CLI、Vite 插件与运行时库",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "clean": " git clean -xdf .turbo node_modules",
    "dev": "turbo run dev",
    "fix": "ultracite fix",
    "fix:unsafe": "ultracite fix --unsafe",
    "lint": "ultracite check",
    "prepare": "lefthook install",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "type- check": "turbo run type-check"
  },
  "resolutions": {},
  "overrides": {
    "cookie": "^2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@typescript/native": "npm:typescript@^7.0.2",
    "lefthook": "^2.1.10",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.10",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.9.3",
    "ultracite": "7.10.7"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "bun",
        "version": "1.3.14",
        "onFail": "download"
      },
      {
        "name": "npm",
        "onFail": "ignore"
      }
    ]
  }
}
