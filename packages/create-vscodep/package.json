{
  "name": "@eastgold15/vscodep-cli",
  "version": "0.2.1",
  "description": "VSCode 扩展开发工具链：脚手架与代码生成",
  "repository": {
    "type": "git",
    "url": "https://github.com/eastgold15/vscode-plugin.git"
  },
  "sideEffects": false,
  "type": "module",
  "bin": {
    "vscodep": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && npm link ",
    "dev": "tsdown --watch",
    "lint": "ultracite check .",
    "lint:fix": "ultracite fix .",
    "prepublishOnly": "bun run build",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@visulima/cerebro": "^3.0.6",
    "@visulima/colorize": "^2.1.1",
    "@visulima/error": "^6.1.0",
    "@visulima/fs": "^6.0.1",
    "@visulima/pail": "^4.1.1",
    "@visulima/path": "^4.0.0",
    "@visulima/string": "^3.1.0",
    "@visulima/tabular": "^4.1.0",
    "chokidar": "^5.0.0",
    "cosmiconfig": "^10.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@eastgold15/vite-plugin-vscode": "workspace:*",
    "@types/bun": "^1.3.6",
    "@types/prompts": "^2.4.9",
    "husky": "^9.1.7",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "ultracite": "7.10.5"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24"
  }
}
